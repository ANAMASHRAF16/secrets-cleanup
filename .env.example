# Copy this file to `.env` (gitignored) and fill in real values for
# local development. In production these come from the runtime
# environment (Lambda env vars, ECS task definition, etc.).
#
# Note: no secrets in this file - it ships in git as the contract that
# documents which variables the application reads. Real values never
# go here, never go into version control, never go into chat messages.

# --- External services (env-var managed) ---
WEATHER_API_KEY=your_openweather_key_here

# --- AWS region & resource names (non-secret) ---
AWS_REGION=us-east-1
S3_BUCKET=weather-ingest-staging
CW_NAMESPACE=WeatherIngest

# --- Database (host/user are env-var; password is fetched from Secrets Manager) ---
DB_HOST=analytics-db.internal
DB_USER=weather_writer
DB_NAME=analytics

# DB password is NOT listed here. It's loaded at runtime from AWS Secrets
# Manager via src.secrets_loader.secret("analytics-db-password"). Set up
# the secret with:
#
#   aws secretsmanager create-secret \
#     --name analytics-db-password \
#     --secret-string "$(openssl rand -base64 32)"

# --- AWS credentials are NOT listed here either ---
# boto3 reads them from the default credential chain:
#   1. AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env vars (if you must)
#   2. ~/.aws/credentials (preferred for local; set up via `aws configure`)
#   3. IAM role attached to the runtime (preferred for production)
