# Copy this file to `.env` (gitignored) and fill in real values for
# local development. In production these come from the runtime
# environment (Lambda env vars, ECS task definition, etc.).
#
# Note: no real secrets in this file - it ships in git as the CONTRACT
# that documents which variables the application reads. Real values
# never go here, never go into version control, never go into chat
# with AI assistants or anywhere else.

# --- External service secrets ---
WEATHER_API_KEY=your_openweather_key_here
DB_PASSWORD=your_db_password_here

# --- AWS region & resource names (non-secret, safe to commit) ---
AWS_REGION=us-east-1
S3_BUCKET=weather-ingest-staging
CW_NAMESPACE=WeatherIngest

# --- Database non-secret config ---
DB_HOST=analytics-db.internal
DB_USER=weather_writer
DB_NAME=analytics

# --- AWS credentials are NOT listed here ---
# boto3 reads them from the default credential chain:
#   1. ~/.aws/credentials (preferred for local; set up via `aws configure`)
#   2. AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env vars (if you must)
#   3. IAM role attached to the runtime (preferred for production)
#
# We deliberately do NOT pass aws_access_key_id / aws_secret_access_key
# to boto3.client(...) in code - that would only re-create the original
# hardcoded-secret problem in disguise.
